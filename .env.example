# Exemplo de variáveis (sem valores reais). Copie para .env.local e preencha.

# Supabase (local: valores do `npx supabase start`; produção: painel do projeto)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Só no servidor (feed .ics do calendário). Nunca usar no navegador. A API de integração NÃO usa esta chave.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Notificações push (chave pública VAPID; a privada fica só nas Edge Functions, em supabase/.env)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxx

# API de integração / MCP (opcionais)
# Emissor dos tokens do Supabase Auth. Padrão: NEXT_PUBLIC_SUPABASE_URL + /auth/v1.
# No ambiente local, quando a URL do app usa o IP da rede, defina: http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_ISSUER=
# Endereço público do servidor MCP (o "resource" do OAuth). Em produção: https://SEU-APP/mcp
MCP_RESOURCE_URL=

# Google Classroom via APIClassroom (docs/CLASSROOM_INTEGRACAO.md). Só no servidor.
# Aplicativo "AgendaJeff" (Regular Web Application) no Auth0 da APIClassroom.
CLASSROOM_AUTH0_DOMAIN=seu-tenant.us.auth0.com
CLASSROOM_AUTH0_CLIENT_ID=
CLASSROOM_AUTH0_CLIENT_SECRET=
# 32 bytes em base64 (cifra dos tokens guardados): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLASSROOM_TOKEN_KEY=
# Mesmo valor do segredo "segredo_cron" do Vault (sincronização automática)
CRON_SECRET=
# Opcionais: e-mails permitidos (vírgula) e URL de retorno do OAuth
CLASSROOM_EMAILS_PERMITIDOS=
CLASSROOM_REDIRECT_URI=
# Só fora de produção: aponta para o simulador dos testes (em produção a URL é fixa)
CLASSROOM_API_URL=

# Opcional: IPs/hosts permitidos no desenvolvimento pelo celular (separados por vírgula)
DEV_ALLOWED_ORIGINS=
